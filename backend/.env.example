# Local PostgreSQL container (started with Podman on port 5433).
DATABASE_URL="postgresql://inventory:inventory_dev_password@127.0.0.1:5433/inventory_finance?schema=public"
DIRECT_URL="postgresql://inventory:inventory_dev_password@127.0.0.1:5433/inventory_finance?schema=public"

# Local-only development secret. Replace it if the app is exposed beyond localhost.
JWT_SECRET="local-development-secret-change-me"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Optional: only needed if Supabase Storage is enabled for file uploads.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_KEY=""
